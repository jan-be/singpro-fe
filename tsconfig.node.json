{
  // What runs in Node or Bun: the build and test configs, the prerenderer, the Playwright suite and the unit tests
  // that read files
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vite-plugin-svgr/client"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "src/prerender/render.tsx",
    "src/components/inlineSvg.test.ts",
    "src/logic/pitch-detection.integration.test.ts"
  ]
}
