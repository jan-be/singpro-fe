+// singpro (tools/ort-minimal): the complex product of the butterflies,
+// inline. std::complex's operator* is an out-of-line call at -Os, half of
+// the STFT's time; this computes the same (a*c - b*d, a*d + b*c), and leaves
+// the rare case where both parts come out NaN (an infinity involved) to it.
+template <typename T>
+static inline std::complex<T> multiply(const std::complex<T>& z, const std::complex<T>& w) {
+  const T ac = z.real() * w.real();
+  const T bd = z.imag() * w.imag();
+  const T ad = z.real() * w.imag();
+  const T bc = z.imag() * w.real();
+  const T x = ac - bd;
+  const T y = ad + bc;
+  if (std::isnan(x) && std::isnan(y)) {
+    return z * w;
+  }
+  return std::complex<T>(x, y);
+}
